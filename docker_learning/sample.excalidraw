      "link": null,
      "locked": false,
      "text": "\ud83d\udc49 STEP 5: Inject Environment Variables at Runtime\nCommand:\ndocker run -e APP_ENV=Production my-python-app:v1\n\nAction: Alters variables dynamically without modifying\nyour source code or building the image again!",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\ud83d\udc49 STEP 5: Inject Environment Variables at Runtime\nCommand:\ndocker run -e APP_ENV=Production my-python-app:v1\n\nAction: Alters variables dynamically without modifying\nyour source code or building the image again!",
      "autoResize": true,
      "lineHeight": 1.3
    },
