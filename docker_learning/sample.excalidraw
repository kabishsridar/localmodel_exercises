      "versionNonce": 1899813788,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1780139500000,
      "link": null,
      "locked": false,
      "text": "\ud83d\udc49 STEP 2: Create Blueprint (Dockerfile)\nFROM python:3.11-slim   -> Set base OS\nWORKDIR /app            -> Set internal folder\nCOPY app.py .           -> Copy your code\nCMD ['python', 'app.py']-> Run automatically",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\ud83d\udc49 STEP 2: Create Blueprint (Dockerfile)\nFROM python:3.11-slim   -> Set base OS\nWORKDIR /app            -> Set internal folder\nCOPY app.py .           -> Copy your code\nCMD ['python', 'app.py']-> Run automatically",
      "autoResize": true,
      "lineHeight": 1.3
    },
